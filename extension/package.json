{
  "name": "palimpsest-git-history",
  "displayName": "Palimpsest — Git Workbench",
  "description": "A Git workbench with interactive history, working changes, branches, and a native floating window.",
  "version": "0.2.0",
  "publisher": "wenhaoquestion",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/wenhaoquestion/palimpsest-git-history.git",
    "directory": "extension"
  },
  "homepage": "https://github.com/wenhaoquestion/palimpsest-git-history#readme",
  "bugs": {
    "url": "https://github.com/wenhaoquestion/palimpsest-git-history/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#101411",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "commit",
    "branch",
    "history",
    "workbench"
  ],
  "main": "./extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onWebviewPanel:palimpsest.history"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Palimpsest runs Git commands to inspect and change the selected repository. Trust the workspace before opening the workbench."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Palimpsest requires a filesystem repository and Git on the workspace host."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "palimpsest",
          "title": "Palimpsest",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "palimpsest": [
        {
          "id": "palimpsest.launcher",
          "name": "Git Workbench",
          "contextualTitle": "Palimpsest"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "palimpsest.launcher",
        "when": "isWorkspaceTrusted",
        "contents": "Explore history and manage your working changes.\n[Open Git Workbench](command:palimpsest.open)\n[Open Changes](command:palimpsest.openChanges)\n[Open in New Window](command:palimpsest.openInNewWindow)\n[Choose a repository](command:palimpsest.openRepository) or [open beside your editor](command:palimpsest.openToSide)."
      },
      {
        "view": "palimpsest.launcher",
        "when": "!isWorkspaceTrusted",
        "contents": "Trust this workspace to open the Git workbench.\n[Manage Workspace Trust](command:workbench.trust.manage)"
      }
    ],
    "commands": [
      {
        "command": "palimpsest.open",
        "title": "Open Git Workbench",
        "category": "Palimpsest",
        "enablement": "isWorkspaceTrusted",
        "icon": "$(git-branch)"
      },
      {
        "command": "palimpsest.openChanges",
        "title": "Open Working Changes",
        "category": "Palimpsest",
        "enablement": "isWorkspaceTrusted",
        "icon": "$(source-control)"
      },
      {
        "command": "palimpsest.openInNewWindow",
        "title": "Open in New Window",
        "category": "Palimpsest",
        "enablement": "isWorkspaceTrusted",
        "icon": "$(link-external)"
      },
      {
        "command": "palimpsest.openToSide",
        "title": "Open to the Side",
        "category": "Palimpsest",
        "enablement": "isWorkspaceTrusted",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "palimpsest.openRepository",
        "title": "Choose Repository…",
        "category": "Palimpsest",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "palimpsest.refresh",
        "title": "Refresh Git History",
        "category": "Palimpsest",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "palimpsest.openRepository",
          "when": "explorerResourceIsFolder && isWorkspaceTrusted",
          "group": "navigation@90"
        }
      ],
      "editor/title": [
        {
          "command": "palimpsest.openInNewWindow",
          "when": "activeWebviewPanelId == palimpsest.history",
          "group": "navigation@1"
        },
        {
          "command": "palimpsest.refresh",
          "when": "activeWebviewPanelId == palimpsest.history",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "palimpsest.openInNewWindow",
          "when": "view == palimpsest.launcher && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "palimpsest.openToSide",
          "when": "view == palimpsest.launcher && isWorkspaceTrusted",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Palimpsest",
      "properties": {
        "palimpsest.workerIdleSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 300,
          "scope": "machine-overridable",
          "description": "Seconds after hiding the workbench before releasing its Git worker and caches. Running Git writes finish before release. Set 0 to release immediately when idle."
        },
        "palimpsest.workerMaxHeapMb": {
          "type": "number",
          "default": 384,
          "minimum": 128,
          "maximum": 2048,
          "scope": "machine-overridable",
          "description": "JavaScript heap limit for the isolated Git worker in MB. Applied when the worker next starts; this is not a total-process memory limit."
        }
      }
    }
  }
}
